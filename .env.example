# -----------------------------------------------------------------------------
# Sanity CMS settings
#
# 1. Copy this file and name the copy `.env` (in the project root).
# 2. Fill in the values below. `npm run setup` can do most of this for you.
# 3. Restart `npm run dev` / `npm run studio` after changing this file.
#
# Never commit your `.env` file. It is already listed in `.gitignore`.
#
# PUBLIC values are safe to share: they end up in the website's HTML/JS.
# SECRET values must stay private: never paste them into client-side code,
# screenshots or chat messages.
# -----------------------------------------------------------------------------


# === Website (Astro) =========================================================

# PUBLIC. Your Sanity project ID (find it at https://www.sanity.io/manage).
# Leave empty to run the theme with the bundled demo content (no Sanity needed).
PUBLIC_SANITY_PROJECT_ID=

# PUBLIC. The dataset that holds your content. Usually "production".
PUBLIC_SANITY_DATASET=production

# PUBLIC. The Sanity API date version. You normally do not need to change it.
PUBLIC_SANITY_API_VERSION=2025-02-19

# PUBLIC. Where your Sanity Studio runs. Used for the "Open Studio" link and
# for click-to-edit in preview mode. Locally that is http://localhost:3333,
# after `npm run studio:deploy` it is something like https://your-name.sanity.studio
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333


# === Preview mode (only for the preview server) ==============================

# SECRET. A Sanity API token with "Viewer" permission, used ONLY by the preview
# server to show unpublished drafts. Create it at https://www.sanity.io/manage
# > your project > API > Tokens. Do NOT set it on your normal (static) host.
SANITY_API_READ_TOKEN=

# Set to "true" to run the website as a small Node server that shows drafts
# and click-to-edit inside Sanity Studio's Presentation tool.
# Leave it empty (or "false") for the normal fast static website.
SANITY_VISUAL_EDITING=false


# === Sanity Studio ===========================================================
# The Studio can only read variables that start with SANITY_STUDIO_.

# PUBLIC. Same value as PUBLIC_SANITY_PROJECT_ID above.
SANITY_STUDIO_PROJECT_ID=

# PUBLIC. Same value as PUBLIC_SANITY_DATASET above.
SANITY_STUDIO_DATASET=production

# PUBLIC. The address of your website (or preview server) that the Studio's
# Presentation tool shows next to the editor. Locally: http://localhost:4321
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
