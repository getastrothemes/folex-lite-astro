# Tina CMS environment variables
# ------------------------------------------------------------------------------
# Local editing (`npm run dev`) works WITHOUT any of these.
# They are only needed to edit the deployed website through Tina Cloud.
# `npm run dev` ignores them and always edits your local files. To try the
# Tina Cloud login locally, copy this file to `.env` and run
# `npm run build && npm run preview`. Never commit `.env`.
# On Netlify / Vercel / Cloudflare, add them in the project's environment
# variable settings instead.

# PUBLIC - Client ID of your Tina Cloud project (app.tina.io > your project > Overview).
# It identifies the project and is visible in the browser, which is expected.
PUBLIC_TINA_CLIENT_ID=

# PRIVATE - Read-only content token (app.tina.io > your project > Tokens).
# Keep it secret: it is only used at build time and on the server.
TINA_TOKEN=

# OPTIONAL - Git branch Tina edits. Detected automatically on Netlify, Vercel,
# Cloudflare Pages and GitHub Actions; defaults to "main".
# TINA_BRANCH=main

# OPTIONAL - Hosting mode: netlify | vercel | node | static.
# Detected automatically on Netlify and Vercel. Live visual editing on the
# deployed site needs netlify, vercel or node (see README).
# TINA_HOSTING=static

# OPTIONAL - Only when the Tina admin is served from another domain
# (for example GitHub Codespaces).
# PUBLIC_TINA_ADMIN_ORIGIN=
