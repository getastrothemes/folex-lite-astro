---
import "aos/dist/aos.css";
import "@/styles/global.css";
import { VisualEditing } from "@sanity/astro/visual-editing";
import config from ".astro/config.generated.json";
import Head from "@/components/global/Head.astro";
import Header from "@/components/global/header/Header.astro";
import HelperButtons from "@/components/utilities/HelperButtons.astro";
import BreakpointIndicator from "@/components/widgets/BreakpointIndicator.astro";
import PreviewBar from "@/components/widgets/PreviewBar.astro";
import FooterThree from "@/components/global/FooterThree.astro";
import GlobalScripts from "./components/widgets/GlobalScripts.astro";
import { getFooter, getNavigation, getSiteSettings } from "@/lib/sanity/data";
import { buildSiteConfig, type PageSeo } from "@/lib/utils/sanityAdapters";

interface Props extends PageSeo {
  className?: string;
  fitToScreen?: boolean;
  footerSpaceTop?: boolean;
  headerPosition?: "fixed" | "static" | "sticky";
  hasHeaderDarkBackground?: boolean;
  hasBodyDarkBackground?: boolean;
  hideOffcanvas?: boolean;
  footerLayout?: "footer-1" | "footer-2" | "footer-3";
}

// destructure props
let {
  className,
  headerPosition = "sticky",
  hideOffcanvas = false,
  hasHeaderDarkBackground = false,
  hasBodyDarkBackground = false,
  footerSpaceTop = true,
  footerLayout = "footer-3",
  fitToScreen = true,
  // SEO props (see `PageSeo`)
  title,
  description,
  seo,
  image,
  disableTagline,
  canonical,
  pageType,
} = Astro.props;

// Current language, e.g. "en" or "fr"
const lang =
  Astro.currentLocale || config.settings.multilingual.defaultLanguage;

// True only on the preview server with a valid draft-mode cookie
const preview = Astro.locals.preview === true;

// Global content from Studio, fetched once per page and passed down
const [settings, navigation, footer] = await Promise.all([
  getSiteSettings(preview),
  getNavigation(lang, preview),
  getFooter(lang, preview),
]);

// Meta tags: config.toml + "Site settings" + this page's SEO fields
const { config: siteConfig, meta } = await buildSiteConfig(settings, {
  title,
  description,
  seo,
  image,
  disableTagline,
  canonical,
  pageType,
});

// Conditionally add min-h-[102vh] class to prevent FOUC (flash of unstyled content) while fast navigation
className = fitToScreen
  ? (className ? className + " " : "") + "fit-to-screen"
  : className;
---

<!doctype html>
<html lang={lang}>
  <Head config={siteConfig} meta={meta} />
  <body class:list={[hasBodyDarkBackground && "bg-body-dark"]}>
    <Header
      position={headerPosition}
      hasDarkBackground={hasHeaderDarkBackground}
      hideOffcanvas={hideOffcanvas}
      settings={settings}
      navigation={navigation}
    />

    <main class:list={[className]}>
      <slot />
    </main>

    {
      footerLayout === "footer-1" ? (
        <div class="py-8 text-center text-sm text-gray-400 italic">
          "Footer Layout One" is only available in the Pro version. Purchase
          Folex premium version to unlock this layout.
        </div>
      ) : footerLayout === "footer-2" ? (
        <div class="py-8 text-center text-sm text-gray-400 italic">
          "Footer Layout Two" is only available in the Pro version. Purchase
          Folex premium version to unlock this layout.
        </div>
      ) : footerLayout === "footer-3" ? (
        <FooterThree
          footerSpaceTop={footerSpaceTop}
          settings={settings}
          footer={footer}
        />
      ) : null
    }

    <HelperButtons />
    <GlobalScripts />
    <BreakpointIndicator />

    {/* Draft preview only: preview bar + click-to-edit overlays */}
    {preview && <PreviewBar />}
    <VisualEditing enabled={preview} />
  </body>
</html>
