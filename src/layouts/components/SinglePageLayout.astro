---
import { stegaClean } from "@sanity/client/stega";
import type { PageData } from "@/lib/sanity/types";
import { portableTextToHtml } from "@/lib/sanity/portableText";
import SanityImage from "./utilities/SanityImage.astro";

interface Props {
  // Page from Sanity (title, optional cover image and rich text body)
  content: Pick<PageData, "title" | "image" | "body">;
  class?: string;
}

const { content, class: className } = Astro.props;
const { title, image, body } = content;

// Rich text → HTML (headings, lists, links and inline images)
const bodyHtml = body?.length ? await portableTextToHtml(body) : "";
---

<section>
  <div class="container">
    <div
      class:list={["has-video-modal max-w-full space-y-10 lg:p-5", className]}>
      {
        image?.asset && (
          <SanityImage
            width={896}
            height={500}
            alt={image.alt || stegaClean(title)}
            image={image}
            class="h-125 w-full object-cover"
          />
        )
      }

      <div class="space-y-2">
        {title && <h1 class="text-h2-sm md:text-h2" set:html={title} />}
      </div>
      <div
        class="prose-styles content has-video-modal prose-headings:mb-6 prose-headings:mt-10"
        set:html={bodyHtml}
      />
    </div>
  </div>
</section>
