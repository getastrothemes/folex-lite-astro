---
import { stegaClean } from "@sanity/client/stega";
import type { ProjectCard } from "@/lib/sanity/types";
import { markdownify, toSentenceCase } from "@/lib/utils/textConverter";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils";
import SanityImage from "@/components/utilities/SanityImage.astro";

type Props = {
  index?: number;
  class?: string;
  translations?: any;
  // Project from Sanity
  content: ProjectCard;
  options?: { layout?: "grid" | "masonry"; appearance?: string };
  [key: string]: any;
};

let {
  index,
  content,
  options: { layout = "grid" } = {},
  options,
  translations,
  class: className,
  ...rest
} = Astro.props;

const { title, slug, categories, coverImage, description } = content;

const t =
  translations || (await useTranslations(Astro.currentLocale as string));
// Project pages live under /portfolio/{slug}/
const href = getLocaleUrlCTM(
  stegaClean(slug),
  Astro.currentLocale,
  "portfolio",
);
const hasCategories = Array.isArray(categories) && categories.length > 0;
const isDarkAppearance = options?.appearance === "dark";
// Link titles are attributes, so visual-editing markers are removed
const linkTitle = toSentenceCase(
  t("common.learnMoreAbout") + " " + stegaClean(title),
);
---

<div
  class:list={[
    className,
    "group",
    layout === "grid" && "flex flex-col items-start justify-start",
    isDarkAppearance ? "text-white" : "text-text-default",
  ]}
  {...rest}>
  {
    coverImage?.asset && (
      <a
        title={linkTitle}
        class:list={[
          "order-1 inline-block w-full overflow-hidden",
          layout === "grid" && "mb-8",
        ]}
        href={href}
        {...{
          "data-aos":
            index !== undefined &&
            ["reveal-anim-left", "reveal-anim-right", "reveal-anim-top"][
              index % 3
            ],
        }}>
        <SanityImage
          image={coverImage}
          alt={coverImage.alt || stegaClean(title) || "Project image"}
          class="h-100 scale-110 object-cover transition duration-500 group-hover:translate-x-2"
        />
      </a>
    )
  }

  {
    hasCategories && (
      <ul
        class:list={[
          "flex flex-wrap items-center gap-x-2 gap-y-1 opacity-80",
          layout === "grid" && "order-3 mt-3",
          isDarkAppearance ? "text-light" : "text-inherit",
        ]}>
        {categories.map((category: string, index: number) => (
          <>
            {index > 0 && <li>/</li>}
            <li set:html={markdownify(category)} />
          </>
        ))}
      </ul>
    )
  }

  {
    title && (
      <h3 class="text-h3-sm md:text-h3 order-2 leading-snug text-inherit">
        <a href={href} title={linkTitle}>
          {title}
        </a>
      </h3>
    )
  }

  {description && <p class="mt-4" set:html={markdownify(description)} />}
</div>
