---
import type { z } from "astro/zod";
import Icons from "@/helpers/Icons.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { pricingSectionSchema } from "@/sections.schema";
import CustomButton from "../CustomButton.astro";
import { tinaAttr } from "@/lib/tina/field";

type PricingCardType = NonNullable<
  z.infer<typeof pricingSectionSchema>
>["list"][0];

type Props = {
  content: PricingCardType;
  class?: string;
  lang?: string;
  [key: string]: any;
};

const {
  class: className,
  content,
  content: { enable, name, price, description, features, button },
  lang,
  ...rest
} = Astro.props;
---

{
  enable && (
    <div
      class:list={[
        "bg-theme-light flex flex-col justify-between space-y-10 p-8",
        className,
      ]}
      {...rest}>
      <div class="space-y-4">
        <div>
          {name && (
            <h3
              class="text-h5 md:text-h4 font-semibold"
              data-tina-field={tinaAttr(content, "name")}
              set:html={markdownify(name)}
            />
          )}
          {price && (
            <div
              class="sm:text-display-5 text-display-6 md:text-display-4 font-secondary font-semibold text-black"
              data-tina-field={tinaAttr(content, "price")}>
              {price.prependValue}
              {price.value}
              <span class="text-lg">{price.appendValue}</span>
            </div>
          )}
        </div>
        {description && (
          <p
            class="text-lg"
            data-tina-field={tinaAttr(content, "description")}
            set:html={markdownify(description)}
          />
        )}
      </div>
      {features && (
        <ul
          class="font-secondary space-y-4 text-sm font-medium text-black"
          data-tina-field={tinaAttr(content, "features")}>
          {features.map((feature) => (
            <li class="flex items-center gap-2">
              <Icons icon="Check" class="text-xl text-black" />
              <span set:html={markdownify(feature)} />
            </li>
          ))}
        </ul>
      )}
      {button?.enable && (
        <CustomButton
          class="effect-color-accent text-center"
          hoverEffect="creative-fill"
          {...button}
          lang={lang}
          data-tina-field={tinaAttr(button)}
        />
      )}
    </div>
  )
}
