---
import type { FooterData, SiteSettings } from "@/lib/sanity/types";
import { markdownify } from "@/lib/utils/textConverter";
import { splitProtectedText } from "@/lib/utils/splitProtectedText";
import {
  emailMarkdown,
  markdownifyLines,
  phoneMarkdown,
} from "@/lib/utils/sanityAdapters";
import SocialComponent from "@/components/widgets/Social.astro";
import ContactForm from "../widgets/ContactForm.astro";

interface Props {
  footerSpaceTop?: boolean;
  // Global settings from Studio ("Site settings")
  settings: SiteSettings;
  // Footer content and contact form from Studio ("Footer & contact form")
  footer: FooterData;
}

const { footerSpaceTop = true, settings, footer } = Astro.props;

const { title, description, copyright, form } = footer;
const {
  contactInfo: { address, email, phone },
  showCopyright,
  socialLinks,
} = settings;

// "{{ year }}" becomes the current year; " / " splits the copyright into parts
const copyrightParts = copyright ? splitProtectedText(copyright) : [];
---

<footer
  id="footer-with-contact"
  class:list={["bg-accent", !footerSpaceTop && "mt-0"]}>
  <div class="container pb-8 md:pb-16">
    <div
      class="grid grid-cols-1 gap-y-10 border-b-2 border-black py-16 md:py-24 lg:grid-cols-2 lg:gap-x-20 xl:gap-x-10">
      <div class="space-y-10">
        {
          title && (
            <h2
              class="text-display-6 xs:text-display-5 md:text-display-4"
              set:html={markdownify(title)}
            />
          )
        }
        {
          description && (
            <div
              class="w-full max-w-lg text-lg"
              set:html={markdownify(description, true)}
            />
          )
        }
        <div class="space-y-4">
          {
            showCopyright && copyrightParts.length > 0 && (
              <ul class="has-list has-list-slash prose-a:text-inherit flex flex-wrap gap-y-2">
                {copyrightParts.map((value) => (
                  <li class="prose-a:text-text-default/70 prose-a:hover:text-text-default">
                    <span set:html={markdownify(value)} />
                  </li>
                ))}
              </ul>
            )
          }

          <SocialComponent
            size="lg"
            layout="dark"
            class="gap-5"
            linkType="follow"
            list={socialLinks}
          />
        </div>
      </div>
      <ContactForm form={form} settings={settings.contactForm} />
    </div>
    <div
      class="font-secondary flex flex-wrap items-center justify-between gap-x-8 gap-y-6 pt-6 text-sm leading-loose font-semibold uppercase">
      {address && <p set:html={markdownifyLines(address)} />}
      <div class="md:text-end">
        {phone && <p set:html={markdownify(phoneMarkdown(phone))} />}
        {email && <p set:html={markdownify(emailMarkdown(email))} />}
      </div>
    </div>
  </div>
</footer>
