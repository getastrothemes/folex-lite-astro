---
import SEO from "@/components/seo/Seo.astro";
import JsonLD from "../widgets/JsonLD.astro";
import Favicons from "../seo/Favicons.astro";
import OpenGraph from "../seo/OpenGraph.astro";
import type { ResolvedPageMeta, SiteConfig } from "@/lib/utils/sanityAdapters";
import { Font } from "astro:assets";
import fontsJson from "@/config/fonts.json";

interface Props {
  // config.toml merged with the "Site settings" from Studio
  config: SiteConfig;
  // Title, description, image and robots of the current page
  meta: ResolvedPageMeta;
  // Languages this page exists in (undefined = every language)
  translations?: string[];
}

const { config, meta, translations } = Astro.props;

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
---

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Language" content={Astro.currentLocale} />
  <meta name="theme" content="folex-lite" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=5"
  />
  <SEO
    title={meta.title}
    metaTitle={meta.metaTitle}
    description={meta.description}
    metaDescription={meta.metaDescription}
    canonical={meta.canonical}
    disableTagline={meta.disableTagline}
    robots={meta.robots}
    config={config}
    translations={translations}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content={"#fff"}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000"
  />
  <meta name="generator" content={Astro.generator} />
  {
    config.head?.content && (
      // Injecting custom scripts such as Google Analytics, Google Tag Manager, etc. tracking code,
      // which should be placed in <head> tag
      <Fragment set:html={config.head?.content} />
    )
  }
  <OpenGraph
    content={{
      title: meta.title,
      metaTitle: meta.metaTitle,
      description: meta.description,
      metaDescription: meta.metaDescription,
      disableTagline: meta.disableTagline,
      image: meta.image,
    }}
    config={config}
  />
  <Favicons config={config} />
  <JsonLD
    content={{
      title: meta.title,
      metaTitle: meta.metaTitle,
      description: meta.description,
      metaDescription: meta.metaDescription,
      disableTagline: meta.disableTagline,
      image: meta.image,
      pageType: meta.pageType,
    }}
    config={config}
    translations={translations}
  />

  <!------------------
    Fonts
-------------------->
  {fontVariables.map((font) => <Font cssVariable={font} />)}
</head>
