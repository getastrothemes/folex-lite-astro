---
import type { SanityImageValue, SiteSettings } from "@/lib/sanity/types";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import SanityImage from "@/components/utilities/SanityImage.astro";
import { markdownify, toSentenceCase } from "@/lib/utils/textConverter";

type Props = {
  // Global settings from Studio ("Site settings")
  settings: SiteSettings;
  // Show this image instead of the main logo (e.g. the light logo)
  image?: SanityImageValue | null;
  class?: string;
  // CSS sizes that override the logo size from Studio (e.g. "11.25rem")
  width?: string;
  height?: string;
  [key: string]: any;
};

const { settings, image, class: className } = Astro.props;
const { logo, logoLight, logoText, title } = settings;

// Logo size from Studio (numbers in px), unless overridden by props
const logoWidth = Astro.props.width || `${settings.logoWidth}px`;
const logoHeight = Astro.props.height || `${settings.logoHeight}px`;
const style = { height: logoHeight, width: logoWidth };
const alt = toSentenceCase("Brand logo of " + title);

const mainLogo = image?.asset ? image : logo;
---

<a
  href={getLocaleUrlCTM("/", Astro.currentLocale)}
  class:list={["logo-wrapper", className]}>
  {
    mainLogo?.asset || logoLight?.asset ? (
      <>
        {mainLogo?.asset && (
          <SanityImage image={mainLogo} class="logo" alt={alt} style={style} />
        )}
        {logoLight?.asset && (
          <SanityImage
            image={logoLight}
            class="logo-alternate"
            alt={alt}
            style={style}
          />
        )}

        {logoText && (
          <span class="logo-text" set:html={markdownify(logoText)} />
        )}
      </>
    ) : logoText ? (
      logoText
    ) : (
      title
    )
  }
</a>
