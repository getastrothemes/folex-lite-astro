---
import { stegaClean } from "@sanity/client/stega";
import type { BannerSectionData } from "@/lib/sanity/types";
import { markdownify } from "@/lib/utils/textConverter";
import { markdownifyLines } from "@/lib/utils/sanityAdapters";
import CustomButton from "@/components/CustomButton.astro";
import SanityImage from "@/components/utilities/SanityImage.astro";

type Props = {
  // Section data from Sanity (see `bannerSection` in Studio)
  content: BannerSectionData;
  // `data-sanity` attribute for visual editing (preview only)
  dataSanity?: string;
};

const { content, dataSanity } = Astro.props;

// Extracting required values from 'content' object
const { title, titleLines, image, description, button } = content;

// Font sizes for the heading (useful if you have a long heading)
const fontSizeMap: Record<BannerSectionData["titleSize"], string> = {
  "display-1": "text-display-3 lg:text-display-2 xl:text-display-1",
  "display-2": "text-display-5 md:text-display-3 xl:text-display-2",
  "display-3": "text-display-5 md:text-display-4 xl:text-display-3",
};

// Options are cleaned so visual-editing markers never break the lookup
const titleSize = stegaClean(content.titleSize);
const fontSize = fontSizeMap[titleSize] || fontSizeMap["display-1"];

// Each line break in the Studio title becomes a <br />
const titleHtml = markdownifyLines(titleLines?.length ? titleLines : title);
---

<section
  class="text-light mb-24 bg-black pt-52 md:mb-32"
  data-sanity={dataSanity}>
  <div class="container">
    <div class="mx-auto max-w-7xl space-y-7 text-center md:space-y-10">
      {
        titleHtml && (
          <h1
            data-aos="reveal-anim-top"
            data-aos-duration="1500"
            class:list={[
              "text-inherit",
              fontSize,
              "block leading-tight font-bold break-words text-inherit",
            ]}
            set:html={titleHtml}
          />
        )
      }
      {
        button?.enable ? (
          <div
            data-aos="reveal-anim-top"
            data-aos-duration="1500"
            data-aos-delay="200"
            class="mx-auto max-w-2xl space-y-6">
            {description && (
              <p
                class="text-lg text-inherit opacity-80"
                set:html={markdownify(description)}
              />
            )}
            <CustomButton
              hoverEffect="creative-fill"
              class="btn-accent effect-color-dark mx-auto"
              {...button}
            />
          </div>
        ) : (
          description && (
            <p
              data-aos="reveal-anim-top"
              data-aos-delay="200"
              data-aos-duration="1500"
              class="mx-auto max-w-2xl text-lg text-inherit opacity-80"
              set:html={markdownify(description)}
            />
          )
        )
      }

      {
        image?.asset && (
          <div
            data-aos="reveal-anim-top"
            data-aos-duration="1500"
            data-aos-delay="300"
            data-aos-offset="0"
            class="mx-auto mt-10 -mb-24 max-w-4xl md:mt-20 md:-mb-32">
            <SanityImage
              image={image}
              alt={image.alt || stegaClean(title) || "Banner"}
              class="h-110 w-full object-cover md:h-135"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
