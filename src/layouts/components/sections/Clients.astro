---
import { stegaClean } from "@sanity/client/stega";
import type { ClientsSectionData } from "@/lib/sanity/types";
import { markdownify } from "@/lib/utils/textConverter";
import SanityImage from "../utilities/SanityImage.astro";

type Props = {
  // Section data from Sanity (see `clientsSection` in Studio)
  content: ClientsSectionData;
  // `data-sanity` attribute for visual editing (preview only)
  dataSanity?: string;
};

const { content, dataSanity } = Astro.props;
const { title, logos } = content;

// Options are cleaned so visual-editing markers never break the comparisons
const appearance = stegaClean(content.appearance);
const columnsPerRow = Number(stegaClean(content.columnsPerRow));

const isDarkAppearance = appearance === "dark";
---

<section data-sanity={dataSanity}>
  <div class="container space-y-8 md:space-y-16">
    {
      title && (
        <div class="mx-auto lg:max-w-3xl">
          <h2
            class:list={[
              "text-h1-sm md:text-h1 text-center",
              isDarkAppearance && "text-light",
            ]}
            set:html={markdownify(title)}
          />
        </div>
      )
    }
    <ul
      class:list={[
        "grid grid-cols-2 justify-center gap-0 overflow-hidden outline",
        isDarkAppearance && "outline-white",
        columnsPerRow === 6
          ? "w-full md:grid-cols-3 lg:grid-cols-6"
          : "mx-auto max-w-4xl lg:grid-cols-4",
      ]}>
      {
        logos?.map((logo) => (
          <li
            class:list={[
              "group flex h-32 w-full items-center justify-center border",
              isDarkAppearance && "border-white",
            ]}>
            {/* The logo is shown twice so it can slide up on hover */}
            <div class="relative h-8 grow overflow-hidden px-8">
              <SanityImage
                width={140}
                height={32}
                image={logo}
                alt={logo.alt || ""}
                class="mx-auto h-8 transition-all duration-300 group-hover:-translate-y-8"
              />
              <SanityImage
                width={140}
                height={32}
                image={logo}
                alt={logo.alt || ""}
                class="mx-auto h-8 transition-all duration-300 group-hover:-translate-y-8"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
