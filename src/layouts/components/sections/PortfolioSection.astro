---
import { stegaClean } from "@sanity/client/stega";
import type { PortfolioSectionData } from "@/lib/sanity/types";
import PortfolioCard from "@/components/cards/PortfolioCard.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { useTranslations } from "@/lib/utils/i18nUtils";

type Props = {
  // Section data from Sanity (see `portfolioSection` in Studio)
  content: PortfolioSectionData;
  // `data-sanity` attribute for visual editing (preview only)
  dataSanity?: string;
};

const { content, dataSanity } = Astro.props;

const t = await useTranslations(Astro.currentLocale as string);

// `projects` already contains the picked (or all) projects with the limit applied
const { title, projects = [] } = content;

// Options are cleaned so visual-editing markers never break the comparisons
const layout: "grid" | "masonry" =
  stegaClean(content.layout) === "masonry" ? "masonry" : "grid";
const appearance = stegaClean(content.appearance);
const options = { layout, appearance };

const isDarkAppearance = appearance === "dark";
---

<section id="projects" data-sanity={dataSanity}>
  <div class:list={[isDarkAppearance && "bg-theme-darker py-20 md:py-32"]}>
    <div class="container space-y-14">
      {
        title && (
          <h2
            class:list={[
              "text-h1-sm md:text-h1 mx-auto max-w-4xl text-center",
              isDarkAppearance && "text-light",
            ]}
            set:html={markdownify(title)}
          />
        )
      }
      <div
        class:list={[
          "gap-x-20 lg:columns-2",
          layout === "grid" && "space-y-10",
        ]}>
        {
          projects.map((item, index) => (
            <PortfolioCard
              class:list={["space-y-4 overflow-hidden"]}
              options={options}
              translations={t}
              content={item}
              index={index}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
