---
import type { PricingSectionData } from "@/lib/sanity/types";
import { markdownify } from "@/lib/utils/textConverter";
import PricingCard from "@/layouts/components/cards/PricingCard.astro";

type Props = {
  // Section data from Sanity (see `pricingSection` in Studio)
  content: PricingSectionData;
  // `data-sanity` attribute for visual editing (preview only)
  dataSanity?: string;
};

const { content, dataSanity } = Astro.props;
const { title, plans = [] } = content;
---

<section id="pricing" data-sanity={dataSanity}>
  <div class="container space-y-14">
    {
      title && (
        <div class="text-center">
          <h2 class="text-h1-sm md:text-h1" set:html={markdownify(title)} />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {plans.map((plan) => <PricingCard content={plan} />)}
    </div>
  </div>
</section>
