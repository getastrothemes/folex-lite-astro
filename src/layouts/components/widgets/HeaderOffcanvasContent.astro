---
import Icons from "@/helpers/Icons.astro";
import type { NavigationData, SiteSettings } from "@/lib/sanity/types";
import Logo from "../global/Logo.astro";
import { markdownify } from "@/lib/utils/textConverter";
import {
  emailMarkdown,
  markdownifyLines,
  phoneMarkdown,
} from "@/lib/utils/sanityAdapters";
import Social from "./Social.astro";
import CustomButton from "@/components/CustomButton.astro";
import Navbar from "../global/header/Navbar.astro";

interface Props {
  // Id of the offcanvas this content lives in (for the close button)
  offcanvas: string;
  // Global settings from Studio ("Site settings")
  settings: SiteSettings;
  // Menu and side panel from Studio ("Navigation menu")
  navigation: NavigationData;
}

const { offcanvas, settings, navigation } = Astro.props;

const { enable, description, button } = navigation.sidePanel;
const { address, phone, email } = settings.contactInfo;

if (!enable) {
  return null;
}
---

<div
  class="text-light h-screen space-y-10 overflow-auto bg-black px-8 pt-20 pb-5 md:px-16 md:pt-32 md:pb-10">
  <button
    type="button"
    data-hs-overlay={`#${offcanvas}`}
    title="Close offcanvas"
    class="border-border-light text-light hover:border-border-dark absolute end-7 top-5 z-20 inline-flex h-14 w-14 items-center justify-center gap-x-2 rounded-full border-2 bg-black text-sm font-medium transition-all duration-500 ease-out hover:rotate-90 hover:bg-white/25"
    aria-expanded="true">
    <Icons icon="X" class="text-2xl" />
  </button>

  <Logo
    class="justify-start"
    width="11.25rem"
    height="3.125rem"
    settings={settings}
    image={settings.logoLight}
  />
  <div class="lg:border-b lg:pb-10">
    {description && <p class="text-lg" set:html={markdownify(description)} />}
  </div>
  <div class="border-y py-10 lg:hidden">
    <Navbar isMobile={true} navigation={navigation} />
  </div>

  <div
    class="prose-a:hover:text-accent prose-a:text-light font-secondary text-sm/loose uppercase">
    {
      address && (
        <address class="not-italic" set:html={markdownifyLines(address)} />
      )
    }
    {
      phone && (
        <p class="mt-4 md:mt-6" set:html={markdownify(phoneMarkdown(phone))} />
      )
    }
    {email && <p set:html={markdownify(emailMarkdown(email))} />}
  </div>

  <Social linkType="follow" size="md" list={settings.socialLinks} />

  {
    button?.enable && (
      <CustomButton
        variant="circle"
        hoverEffect="creative-fill"
        class="btn-accent m-0 ms-auto hidden justify-center lg:flex"
        {...button}
      />
    )
  }
</div>
