---
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import JsonLdGenerator from "@/lib/utils/JsonLdGenerator";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import type { SiteConfig } from "@/lib/utils/sanityAdapters";

interface Props {
  // Title, description, image, ... of the current page
  content: Record<string, any>;
  // config.toml merged with the "Site settings" from Studio
  config: SiteConfig;
  // Languages this page exists in (undefined = every language)
  translations?: string[];
}

const { content, config, translations } = Astro.props;

let {
  title = config.site.title,
  metaTitle = title,
  description = config.site.description,
  metaDescription = description,
  image = config.opengraph.image,
  taglineSeparator = " - ",
  disableTagline,
  canonical,
  lang,
  author = config.seo.author,
  structuredData,
  pageType,
} = content;

// Only languages where this page really exists
const alternateLangs = config.settings.multilingual.enable
  ? supportedLanguages.filter(
      (lang) =>
        !translations?.length || translations.includes(lang.languageCode),
    )
  : [];

title =
  !disableTagline && metaTitle
    ? `${metaTitle}${config.site.tagline ? taglineSeparator + config.site.tagline : ""}`
    : config.site.title;

description = metaDescription ? metaDescription : description;
canonical = canonical ? canonical : Astro.url.href;
lang = Astro.currentLocale;
image = image ? absoluteUrl(image, Astro) : undefined;

// Generate JSON-LD dynamically
const jsonLdData = JsonLdGenerator(
  {
    ...structuredData,
    title,
    description,
    image,
    canonical,
    author,
    lang,
    alternateLangs,
    pageType,
    config,
  },
  Astro,
);

// Content from Studio could contain "</script>", so "<" is escaped as \u003c
// (still valid JSON) to keep the script tag from being closed early
const jsonLdHtml = JSON.stringify(
  jsonLdData,
  null,
  import.meta.env.DEV ? 2 : 0,
).replace(/</g, "\\u003c");
---

<!-- JSON-LD -->{
  content ? (
    <script type="application/ld+json" is:inline set:html={jsonLdHtml} />
  ) : null
}
