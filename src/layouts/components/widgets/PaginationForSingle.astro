---
import { stegaClean } from "@sanity/client/stega";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils";
import CustomButton from "@/components/CustomButton.astro";

// Previous/next item ({ title, slug }), e.g. from `getProject()`
type PageLink = { title?: string; slug: string } | null | undefined;

interface Props {
  prevBtnText?: string;
  nextBtnText?: string;
  prev?: PageLink;
  next?: PageLink;
  // URL folder of the items, e.g. "portfolio" → /portfolio/{slug}/
  collection?: string;
  class?: string;
}

const t = await useTranslations(Astro.currentLocale as string);

let {
  prevBtnText = t("common.paginationPrevious"),
  nextBtnText = t("common.paginationNext"),
  prev,
  next,
  collection,
  class: className,
} = Astro.props;

const toUrl = (item: NonNullable<PageLink>) =>
  getLocaleUrlCTM(stegaClean(item.slug), Astro.currentLocale, collection);
---

<nav
  id="pagination"
  class:list={[
    "flex w-full flex-wrap items-center justify-between gap-3 font-normal",
    className,
  ]}
  aria-label="Pagination">
  {/* previous */}
  {
    prev?.slug && (
      <CustomButton
        hoverEffect="creative-fill"
        url={toUrl(prev)}
        label={prevBtnText}
        class="effect-color-accent me-auto"
      />
    )
  }

  {/* next page */}
  {
    next?.slug && (
      <CustomButton
        hoverEffect="creative-fill"
        url={toUrl(next)}
        label={nextBtnText}
        class="effect-color-accent ms-auto"
      />
    )
  }
</nav>
