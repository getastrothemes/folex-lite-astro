---
import Base from "@/layouts/Base.astro";
import CustomButton from "@/components/CustomButton.astro";
import { getSiteSettings } from "@/lib/sanity/data";

// Texts from Studio ("Site settings" → 404 page), with the theme defaults
const { notFound } = await getSiteSettings(Astro.locals.preview === true);
const title = notFound.title || "Look Like You’re Lost";
const description =
  notFound.description ||
  "The link you followed probably broken or the page has been removed";
const buttonLabel = notFound.buttonLabel || "Back to Home";
---

<Base
  title="Page Not Found"
  seo={{ noIndex: true }}
  disableTagline={true}
  fitToScreen={false}>
  <section>
    <div class="container">
      <div class="flex flex-col items-center gap-y-10">
        <div class="space-y-4 text-center text-lg">
          <h1 class="text-8xl font-bold sm:text-9xl md:text-[16rem]">404</h1>
          <h2 class="text-h1-sm md:text-h1">{title}</h2>
          <p>{description}</p>
        </div>
        <CustomButton
          hoverEffect="creative-fill"
          class="effect-color-accent uppercase"
          label={buttonLabel}
          url="/"
        />
      </div>
    </div>
  </section>
</Base>
