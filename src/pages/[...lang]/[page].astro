---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import config from ".astro/config.generated.json";
import extractSlug from "@/lib/utils/extractSlug";
import PageSections from "@/components/PageSections.astro";
import EditableRegion from "@/components/tina/EditableRegion.astro";
import { DEFAULT_PAGE_SECTIONS, resolveSections } from "@/lib/pageSections";
import { loadSectionsFromCollections } from "@/lib/tina/collectionData";

// get static paths for all pages
export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      let pages = await getCollectionCTM("pages", lang.languageCode);

      // Generate static path entry
      return pages.map((page) => ({
        params: {
          lang:
            !showDefaultLangInUrl && lang.languageCode === defaultLanguage
              ? undefined
              : lang.languageCode,
          page: extractSlug(page).split("/").pop(),
        },
        props: {
          page,
        },
      }));
    }),
  );

  return paths.flat();
}

const { page } = Astro.props;
const lang = Astro.currentLocale;

// Pages show their text by default. The `sections` list (editable in the CMS)
// can add theme sections around it.
const sections = resolveSections(page.data.sections, DEFAULT_PAGE_SECTIONS);
const bundle = await loadSectionsFromCollections(sections, lang);

// The header overlays the dark hero banner when the page starts with it.
const startsWithBanner =
  sections[0] === "banner" && bundle.data.banner?.enable !== false;
---

<Base
  {...page.data}
  headerPosition={startsWithBanner ? "fixed" : undefined}
  hasHeaderDarkBackground={startsWithBanner}>
  <EditableRegion
    name="page"
    params={{ lang: lang ?? "", file: page.filePath?.split("/").pop() ?? "" }}
    primary>
    <PageSections sections={sections} bundle={bundle} lang={lang} page={page} />
  </EditableRegion>
</Base>
