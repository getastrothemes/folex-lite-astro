---
import Base from "@/layouts/Base.astro";
import HomeLayout from "@/layouts/HomeLayout.astro";
import SinglePageLayout from "@/components/SinglePageLayout.astro";
import PageSections from "@/components/sections/PageSections.astro";
import { getAllPageSlugs, getHomePage, getPage } from "@/lib/sanity/data";
import { langToParam, resolveLangParam } from "@/lib/utils/i18nUtils";
import { startsWithBanner } from "@/lib/utils/sanityAdapters";

// Static builds: every published page of every enabled language
export async function getStaticPaths() {
  const pages = await getAllPageSlugs();
  return pages.map(({ lang, slug }) => ({
    params: { lang: langToParam(lang), page: slug },
  }));
}

// The data is resolved from the URL (not from getStaticPaths props) so the
// same page also works on the preview server
const preview = Astro.locals.preview === true;
const { lang: langParam, page: slug } = Astro.params;

// On the preview server a language home such as `/fr/` also matches this
// route (as `{ page: "fr" }`), so that home page is rendered here
const homeLang = !langParam && slug ? resolveLangParam(slug) : null;
const home = homeLang ? await getHomePage(homeLang, preview) : null;

const lang = resolveLangParam(langParam);
const page = !home && lang && slug ? await getPage(lang, slug, preview) : null;

// Unknown language prefix or page → 404 page
if (!home && !page) {
  return new Response(null, { status: 404 });
}

// The title/body block (with the page's h1) is shown unless the page opens
// with a banner section, which has its own big heading
const hasBody = !!page?.body?.length;
const showPageContent =
  hasBody || !!page?.image?.asset || !startsWithBanner(page?.sections);

// A page that starts with a banner gets the fixed, transparent header
const hasBanner = !showPageContent && startsWithBanner(page?.sections);
---

{
  home ? (
    <HomeLayout page={home} />
  ) : (
    page && (
      <Base
        title={page.title}
        seo={page.seo}
        image={page.image}
        headerPosition={hasBanner ? "fixed" : "sticky"}
        hasHeaderDarkBackground={hasBanner}
        translations={page.translations}>
        {showPageContent && <SinglePageLayout content={page} />}
        <PageSections
          document={page}
          sections={page.sections}
          hasPageHeading={showPageContent && !!page.title}
        />
      </Base>
    )
  )
}
