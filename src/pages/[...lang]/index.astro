---
import HomeLayout from "@/layouts/HomeLayout.astro";
import { getHomePage } from "@/lib/sanity/data";
import { generatePaths, resolveLangParam } from "@/lib/utils/i18nUtils";

// Static builds: one home page per enabled language (`/` and `/fr/`)
export function getStaticPaths() {
  return generatePaths();
}

// The data is resolved from the URL (not from getStaticPaths props) so the
// same page also works on the preview server
const lang = resolveLangParam(Astro.params.lang);
const page = lang
  ? await getHomePage(lang, Astro.locals.preview === true)
  : null;

// Unknown language prefix or missing home page document → 404 page
if (!page) {
  return new Response(null, { status: 404 });
}
---

<HomeLayout page={page} />
