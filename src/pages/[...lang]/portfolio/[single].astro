---
import Base from "@/layouts/Base.astro";
import PortfolioSingle from "@/components/PortfolioSingle.astro";
import Breadcrumbs from "@/components/widgets/Breadcrumbs.astro";
import { getAllProjectSlugs, getProject } from "@/lib/sanity/data";
import { langToParam, resolveLangParam } from "@/lib/utils/i18nUtils";

// Static builds: every published project of every enabled language
export async function getStaticPaths() {
  const projects = await getAllProjectSlugs();
  return projects.map(({ lang, slug }) => ({
    params: { lang: langToParam(lang), single: slug },
  }));
}

// The data is resolved from the URL (not from getStaticPaths props) so the
// same page also works on the preview server
const lang = resolveLangParam(Astro.params.lang);
const slug = Astro.params.single;
const project =
  lang && slug
    ? await getProject(lang, slug, Astro.locals.preview === true)
    : null;

// Unknown language prefix or project → 404 page
if (!project) {
  return new Response(null, { status: 404 });
}
---

<Base
  title={project.title}
  description={project.description}
  seo={project.seo}
  image={project.coverImage}>
  <Breadcrumbs breadcrumbExcludedPaths={["Portfolio"]} />
  <PortfolioSingle content={project} />
</Base>
